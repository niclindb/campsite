# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git, so the key never lands in the repo.
# Restrict this key in Google Cloud to your site's domain and the Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=

# Contact form: create a free form at formspree.io and paste its ID (the part after /f/).
VITE_FORMSPREE_ID=
